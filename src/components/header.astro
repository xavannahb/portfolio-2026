---
const currentPath = Astro.url.pathname;
---

<header class="navbar">
    <ul>
        <li><a href="/" class="logo">Xavannah Baars</a></li>
        <li><button><img src="../../images/menu-dropdown.svg"></button></li>
    </ul>
        <nav>
            <ul>
                <li><a href="/" class="logo">Xavannah Baars</a></li>
                <li><a href="/work">Work</a>
                {currentPath.startsWith("/work") && (
                        <div class="scribble">
                            <svg viewBox="0 0 230 12" width="85" fill="none" aria-hidden="true">
                            <path class="draw" d="M3,8 C60,2 150,12 227,5" stroke="#1f3fc7" stroke-width="3.8" stroke-linecap="round"></path>
                        </svg>
                    </div>
                )}</li>

                <li><a href="/about">About</a>
                    {currentPath.startsWith("/about") && (
                        <div class="scribble">
                            <svg viewBox="0 0 230 12" width="50" fill="none" aria-hidden="true">
                            <path class="draw" d="M3,8 C60,2 150,12 227,5" stroke="#1f3fc7" stroke-width="6" stroke-linecap="round"></path>
                        </svg>
                    </div>
                )}</li>

                <li><a href="/contact">Contact</a>
                    {currentPath.startsWith("/contact") && (
                        <div class="scribble">
                            <svg viewBox="0 0 230 12" width="70" fill="none" aria-hidden="true">
                            <path class="draw" d="M3,8 C60,2 150,12 227,5" stroke="#1f3fc7" stroke-width="4.5" stroke-linecap="round"></path>
                        </svg>
                    </div>
                )}</li>
            </ul>
        </nav>
</header>
<style>
    /* Header styling */

    header {
        position: sticky;
        z-index: 5; /* zelfde of hoger, ipv 1 */
    }

    header ul {
        list-style: none;
        padding: 0;
    }

    header ul:nth-of-type(1) {
        margin: 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    header nav {
        position: fixed;
        inset: 0;
        background-color: var(--background-color);
        z-index: 5; /* zelfde of hoger, ipv 1 */
        translate: -100%;
        transition: 0.5s;
    }

    header nav.open {
        translate: 0;
    }
    
    header img {
        width: 30px;
        height: 30px;
    }

    header button {
        position: relative;
        z-index: 6;
        background-color: var(--background-color);
        border: none;
        padding: 0;
    }

    header nav ul {
        padding: 0;
    }

    header li {
        padding: 1em;
        margin: 0;
        position: relative;
    }
    .scribble {
        position: absolute;
        left: 1em; /* zelfde als je li padding */
        bottom: 0;
        pointer-events: none;
    }
    header nav ul:nth-of-type(1) {
        display: flex;
        flex-direction: column;
        align-items: baseline;
    }

    header.navbar ul li a.logo {
        font-family: Caveat, cursive;
        font-size: var(--text-logo);
        color: var(--accent-color);
        line-height: 1;
        margin-bottom: 6px;
        text-transform: none;
    }

    header a { 
        color: var(--text-color);
        text-decoration: none;
        text-transform: uppercase;
        font-size: 12px;
    }

    header a:hover, header a:active, header a:focus {
        color:  var(--text-color);
    }

    header a.active-state {
        color: var(--text-color);
    }

    @media (width > 800px) {
    header {
        width: 85%;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    header nav {
        position: relative;
        background-color: none;
        translate: 0;
        transition: 0.5s;
    }

    header nav ul:nth-of-type(1) {
        flex-direction: unset;
        align-items: center;
        justify-content: space-between;
    }

    header nav ul:nth-of-type(1) li:nth-of-type(1) a.logo {
        display: none;
    }

    header button {
        display: none;
    }
    }
</style>
<script>
    // @ts-nocheck
    const menuButton = document.querySelector("header button")
    const deNav = document.querySelector("header nav")

    menuButton.onclick = toggleMenu 

    function toggleMenu() {
        deNav.classList.toggle("open")
    }
</script>