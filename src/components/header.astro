<header>
    <div id="progress-bar"></div>
    <div class="bar">
        <a href="#" class="logo"><span class="dot"></span>XAVANNAH BAARS</a>
        <nav>
            <a href="#about">ABOUT</a>
            <a href="#work">WORK</a>
            <a href="#cv">CV</a>
            <a href="#contact">CONTACT</a>
        </nav>
    </div>
</header>

<style>
header {
    background: var(--cream);
    position: sticky;
    top: 0;
    z-index: 999;
    font-family: 'Courier New', Courier, monospace;
}

#progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 5px;
    width: 0%;
    background: var(--red);
    z-index: 1000;
    transition: width 0.1s ease-out;
}

.bar {
    max-width: 1400px;
    margin: 0 auto;
    padding: 22px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 15px;
    letter-spacing: 0.08em;
    color: var(--text);
    text-decoration: none;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--red);
    flex-shrink: 0;
  }

  nav {
    display: flex;
    gap: 40px;
  }

  nav a {
    color: var(--text);
    text-decoration: none;
    font-size: 14px;
    letter-spacing: 0.08em;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--red);
  }

  nav a:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 4px;
  }

  @media (max-width: 640px) {
    .bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
      padding: 20px 24px;
    }
    nav {
      gap: 24px;
      flex-wrap: wrap;
    }
  }
</style>

<script>
  window.addEventListener('scroll', () => {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    const bar = document.getElementById('progress-bar');
    if (bar) bar.style.width = progress + '%';
  });
</script>