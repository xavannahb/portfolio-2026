<style>

h2 {
    font-family: Arial, Helvetica, sans-serif;
}
.mono {
    font-family: "Courier New", Courier, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

section {
    max-width: 1800px;
    margin: 0 auto;
    padding: 0 40px 60px;
    border-top: 1px solid var(--line);
}
 
.eyebrow {
    display: flex;
    justify-content: space-between;
    padding: 22px 0;
    font-size: 12px;
}
 
.eyebrow .index { color: var(--red); }
 
.project {
    border-top: 1px solid var(--line);
}
  .project:last-of-type {
    border-bottom: 1px solid var(--line);
  }
 
  /* <details name="project"> handles exclusive open/close natively */
  summary.row {
    display: grid;
    grid-template-columns: 44px 1fr auto 40px;
    align-items: center;
    gap: 24px;
    padding: 28px 0;
    cursor: pointer;
    list-style: none;
    font-size: 12px;
  }
  summary.row::-webkit-details-marker,
  summary.row::marker { display: none; content: ""; }
 
  .row .num { color: var(--red); font-family: inherit; }
 
  .row h2 {
    margin: 0;
    font-size: clamp(40px, 5.5vw, 68px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--text);
    text-transform: none;
  }
  .project.is-red .row h2 { color: var(--red); }
 
  .row .meta { text-align: right; color: var(--muted); line-height: 1.6; }
 
  /* plus/close icon: two lines rotated into an × when open, no extra markup */
  .row .icon {
    position: relative;
    width: 16px;
    height: 16px;
    justify-self: end;
    transition: transform 0.25s ease;
  }
  .row .icon::before,
  .row .icon::after {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    background: var(--red);
  }
  .row .icon::before { width: 16px; height: 2px; transform: translate(-50%, -50%); }
  .row .icon::after   { width: 2px; height: 16px; transform: translate(-50%, -50%); }
  .project[open] .row .icon { transform: rotate(45deg); }
 
  /* single wrapper does both jobs: 0fr->1fr height animation AND clips
     overflow during it -- no separate inner div needed */
  .detail {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 0.35s ease;
  }
  .project[open] .detail { grid-template-rows: 1fr; }
 
  .detail > .cols {
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    padding-bottom: 48px;
  }
 
  .figure {
    position: relative;
    aspect-ratio: 4 / 5;
    background: repeating-linear-gradient(135deg, #e4ddcf 0 2px, #ddd4c1 2px 4px);
  }
  .figure.wide { aspect-ratio: 4 / 3; }
 
  .figure .hotspot {
    position: absolute;
    top: 42%;
    left: 40%;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--red);
  }
  .figure .cap {
    position: absolute;
    left: 16px;
    bottom: 14px;
    font-size: 11px;
    color: var(--muted);
  }
 
  .copy .lede { font-size: 24px; line-height: 1.4; margin: 0 0 28px; }
 
  /* facts: a definition list is the semantically correct element for
     label/value pairs -- no need for div + h3 + p per item */
  .facts {
    display: flex;
    gap: 60px;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 24px;
    margin: 0 0 24px;
  }
  .facts dt { font-size: 12px; color: var(--red); margin: 0 0 8px; }
  .facts dd { font-size: 13px; letter-spacing: 0.04em; margin: 0; }
 
  /* points: an ordered list with a CSS counter supplies the "01/02/03"
     styling -- no need for a span + p per item */
  .points {
    counter-reset: point;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .points li {
    counter-increment: point;
    padding-left: 38px;
    position: relative;
    font-size: 16px;
    line-height: 1.6;
  }
  .points li::before {
    content: "0" counter(point);
    position: absolute;
    left: 0;
    top: 0;
    font-size: 12px;
    color: var(--red);
    font-family: "Courier New", Courier, monospace;
  }
 
  .gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    padding-bottom: 8px;
  }
 
@media (max-width: 900px) {
    summary.row { grid-template-columns: 30px 1fr 30px; row-gap: 8px; }
    .row .meta { display: none; }
    .detail > .cols { grid-template-columns: 1fr; }
    .facts { flex-wrap: wrap; gap: 28px; }
}
</style>
